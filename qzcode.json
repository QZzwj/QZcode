{
  "workspace": ".",
  "maxRounds": 3,
  "maxSteps": 40,
  "exec": {
    "enabled": true,
    "timeoutMs": 300000
  },
  "tui": {
    "columns": "auto",
    "showTokens": true
  },
  "review": {
    "enabled": true,
    "maxCorrections": 2
  },
  "leader": {
    "enabled": true,
    "directMaxTokens": 900,
    "directMaxChars": 80
  },
  "roles": {
    "leader": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-chat",
      "temperature": 0.1,
      "maxTokens": 1024
    },
    "planner": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-chat",
      "temperature": 0.3,
      "maxTokens": 4096
    },
    "implementer": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-chat",
      "temperature": 0.2,
      "maxTokens": 8192
    },
    "verifier": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-reasoner",
      "temperature": 0.1,
      "maxTokens": 4096
    }
  },
  "plugins": ["./plugins/pi-style-extension.ts", "./plugins/example-plugin.ts"]
}
