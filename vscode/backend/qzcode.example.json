{
  "workspace": ".",
  "maxRounds": 3,
  "maxSteps": 40,
  "exec": {
    "enabled": true,
    "timeoutMs": 300000
  },
  "tui": {
    "columns": "auto",
    "showTokens": true
  },
  "roles": {
    "planner": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-chat",
      "temperature": 0.3,
      "maxTokens": 4096
    },
    "implementer": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-chat",
      "temperature": 0.2,
      "maxTokens": 8192
    },
    "verifier": {
      "provider": "deepseek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-reasoner",
      "temperature": 0.1,
      "maxTokens": 4096
    }
  },
  "plugins": []
}
